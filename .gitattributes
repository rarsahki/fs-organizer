# Normalize to LF in the repository, and let Git check out what each
# platform expects.
* text=auto

# Windows script hosts are the fussiest consumers here, and these are only
# ever run by Windows, so pin them to CRLF on checkout.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep Python and docs LF everywhere.
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
